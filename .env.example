# Is file ko copy karke naam rakhein  .env   (sirf ".env", koi .example nahi)
# Phir neeche apni key likhein. .env kisi ko share na karein, GitHub par upload na karein.

# Google AI Studio se free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=yahan_apni_key_paste_karein

# Model ka naam. Google naam tezi se badalta hai. Agar error aaye to AI Studio mein current Flash model ka naam dekh kar yahan likhein.
GEMINI_MODEL=gemini-flash-latest

# Optional settings
PORT=3000
MAX_INPUT_CHARS=15000
RATE_LIMIT_PER_MINUTE=10
DAILY_LIMIT=300
